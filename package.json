{
  "name": "markterm",
  "version": "0.2.0",
  "description": "Render Markdown + MermaidJS as inline images in Ghostty, Kitty, iTerm2, WezTerm and other terminals.",
  "keywords": [
    "markdown",
    "mermaid",
    "terminal",
    "kitty",
    "ghostty",
    "iterm2",
    "wezterm",
    "sixel",
    "inline-image",
    "cli"
  ],
  "license": "MIT",
  "author": "Gospelo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gospelo-dev/markterm.git"
  },
  "homepage": "https://github.com/gospelo-dev/markterm#readme",
  "bugs": {
    "url": "https://github.com/gospelo-dev/markterm/issues"
  },
  "type": "module",
  "bin": {
    "markterm": "dist/cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "bun test",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && bun build src/cli.ts --outfile dist/cli.js --target node --external playwright",
    "postbuild": "chmod +x dist/cli.js",
    "prepublishOnly": "bun run typecheck && bun test && bun run build"
  },
  "dependencies": {
    "marked": "^15.0.7",
    "playwright": "^1.52.0"
  },
  "engines": {
    "node": ">=20",
    "bun": ">=1.1.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "bun-types": "^1.3.13",
    "typescript": "^5.8.2"
  }
}
